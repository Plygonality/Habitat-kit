{
  "format": "gn-as-code",
  "version": 1,
  "name": "HK Hatch",
  "kind": "GROUP",
  "blender": "4.2",
  "interface": {
    "inputs": [
      {
        "name": "Scale",
        "socket": "FLOAT",
        "default": 1,
        "min": 0.01,
        "max": 50,
        "description": "Uniform actor scale around the primary attach origin"
      },
      {
        "name": "Attach Location",
        "socket": "VECTOR",
        "default": [
          0,
          0,
          0
        ],
        "description": "World position of the primary attach (feet, dock, centroid)"
      },
      {
        "name": "Attach Rotation",
        "socket": "VECTOR",
        "default": [
          0,
          0,
          0
        ],
        "description": "Euler XYZ in radians. Z-up, Y-forward."
      },
      {
        "name": "Hull",
        "socket": "MATERIAL",
        "description": "Master-Node metal (MN Metal). Bind a category master, not a unique shader."
      },
      {
        "name": "Glass",
        "socket": "MATERIAL",
        "description": "Master-Node glass (MN Glass). Canopy / dome / viewport."
      },
      {
        "name": "Meters Per Grid",
        "socket": "FLOAT",
        "default": 1,
        "min": 0,
        "subtype": "DISTANCE",
        "description": "World-grid spacing. GN snap, array pitch, collection-linter grid."
      },
      {
        "name": "Deck Height",
        "socket": "FLOAT",
        "default": 3,
        "min": 0,
        "subtype": "DISTANCE",
        "description": "Floor-to-floor spacing. Integer multiple of meters per grid."
      },
      {
        "name": "Airlock Diameter",
        "socket": "FLOAT",
        "default": 1,
        "min": 0,
        "subtype": "DISTANCE",
        "description": "Clear circular hatch / tube diameter."
      },
      {
        "name": "Human Standing Height",
        "socket": "FLOAT",
        "default": 1.8,
        "min": 0,
        "subtype": "DISTANCE",
        "description": "Scale-reference figure height (UE5 mannequin class)."
      },
      {
        "name": "Human Eye Height",
        "socket": "FLOAT",
        "default": 1.65,
        "min": 0,
        "subtype": "DISTANCE",
        "description": "Camera / occupancy eye line on the scale figure."
      },
      {
        "name": "Human Shoulder Width",
        "socket": "FLOAT",
        "default": 0.45,
        "min": 0,
        "subtype": "DISTANCE",
        "description": "Figure breadth; must pass through the airlock."
      }
    ],
    "outputs": [
      {
        "name": "Geometry",
        "socket": "GEOMETRY"
      },
      {
        "name": "Attach",
        "socket": "VECTOR"
      },
      {
        "name": "Hatch Attach",
        "socket": "VECTOR"
      }
    ]
  },
